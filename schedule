<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dog Feeder - Schedule</title>
<script>
  try { if (localStorage.getItem("feederAuth") !== "ok") location.replace("login.html"); }
  catch(e) { location.replace("login.html"); }
</script>
<style>
  :root{--bg:#2b3138;--card:#363d46;--line:#4a535e;--text:#e3e7eb;--muted:#9aa5b1;--accent:#7f9bb3;--ok:#7fae93;--warn:#c9a46b;--bad:#d98a8a}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;justify-content:center;padding:24px}
  .wrap{width:100%;max-width:420px}
  .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
  h1{font-size:1.3rem;font-weight:600;margin:0}
  .small{background:transparent;border:1px solid var(--line);color:var(--muted);border-radius:8px;padding:6px 12px;cursor:pointer;font-size:.8rem}
  .small:disabled{opacity:.4;cursor:default}
  .small:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden}
  .head{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;cursor:pointer;width:100%;background:none;border:0;color:var(--text);font-size:1rem;text-align:left}
  .head .n{color:var(--muted);font-size:.85rem}
  .body{padding:0 18px 16px;display:none}
  .card.open .body{display:block}
  .bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;color:var(--muted);font-size:.85rem}
  .slot{display:flex;gap:8px;align-items:center;padding:8px 0;border-top:1px solid var(--line)}
  .slot input,.slot select{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:9px;font-size:.95rem}
  .slot input{flex:1;min-width:0}
  .slot select{width:78px}
  .slot .small{padding:7px 9px}
  .slot .del{color:var(--bad)}
  .add{width:100%;margin-top:8px;padding:11px;border-radius:10px;border:1px dashed var(--line);background:transparent;color:var(--accent);cursor:pointer;font-size:.95rem}
  .empty{color:var(--muted);font-size:.9rem;padding:6px 0}
  .save{width:100%;padding:16px;border:0;border-radius:12px;background:var(--ok);color:#14181c;font-size:1.05rem;font-weight:700;cursor:pointer}
  .save:disabled{opacity:.5}
  .status{margin-top:10px;font-size:.85rem;color:var(--muted);min-height:1.2em}
  .status.dirty{color:var(--warn)}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>🗓️ Schedule</h1>
    <button class="small" onclick="location.href='index.html'">Back</button>
  </div>
  <div id="days"></div>
  <button class="save" id="saveBtn">Save schedule</button>
  <div class="status" id="status">Loading...</div>
</div>
 
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<script>
  firebase.initializeApp({ databaseURL: "https://dog-feeder-63c72-default-rtdb.firebaseio.com" });
  const schedRef = firebase.database().ref("schedule");
 
  const DAYS = [["mon","Monday"],["tue","Tuesday"],["wed","Wednesday"],["thu","Thursday"],["fri","Friday"],["sat","Saturday"],["sun","Sunday"]];
  const sched = {};            // key -> [{time:"HH:MM", revs:1-3}]
  DAYS.forEach(([k]) => sched[k] = []);
  const open = new Set();
  let clip = null;             // copied slot
  let loaded = false;
 
  const $ = id => document.getElementById(id);
  function setStatus(msg, dirty){ $("status").textContent = msg; $("status").classList.toggle("dirty", !!dirty); }
  function markDirty(){ setStatus("Unsaved changes", true); }
 
  // "07:30-2,18:00-1"  <->  [{time,revs}]
  function parse(str){
    if(typeof str !== "string" || !str) return [];
    return str.split(",").map(p => { const m = p.match(/^(\d\d:\d\d)-([1-3])$/); return m ? {time:m[1], revs:+m[2]} : null; }).filter(Boolean);
  }
  function serialize(list){
    return list.filter(s => /^\d\d:\d\d$/.test(s.time)).map(s => s.time + "-" + s.revs).join(",");
  }
  function sortDay(k){ sched[k].sort((a,b) => (a.time || "99:99").localeCompare(b.time || "99:99")); }
 
  function fmt(t){
    if(!t) return "";
    const [h,m] = t.split(":").map(Number);
    return ((h % 12) || 12) + ":" + String(m).padStart(2,"0") + (h < 12 ? " AM" : " PM");
  }
 
  function render(){
    const root = $("days");
    root.innerHTML = "";
    DAYS.forEach(([k,name]) => {
      const list = sched[k];
      const card = document.createElement("div");
      card.className = "card" + (open.has(k) ? " open" : "");
 
      const head = document.createElement("button");
      head.className = "head";
      head.innerHTML = "<span></span><span class='n'></span>";
      head.children[0].textContent = name;
      head.children[1].textContent = list.length ? list.length + (list.length > 1 ? " feedings" : " feeding") : "No feedings";
      head.onclick = () => { open.has(k) ? open.delete(k) : open.add(k); render(); };
      card.appendChild(head);
 
      const body = document.createElement("div");
      body.className = "body";
 
      const bar = document.createElement("div");
      bar.className = "bar";
      const hint = document.createElement("span");
      hint.textContent = clip ? "Copied: " + fmt(clip.time) + ", " + clip.revs + " rev" + (clip.revs > 1 ? "s" : "") : "Nothing copied";
      const paste = document.createElement("button");
      paste.className = "small";
      paste.textContent = "Paste";
      paste.disabled = !clip;
      paste.onclick = () => {
        if(list.some(s => s.time === clip.time)) { setStatus(name + " already has " + fmt(clip.time), true); return; }
        list.push({time: clip.time, revs: clip.revs});
        sortDay(k); markDirty(); render();
      };
      bar.append(hint, paste);
      body.appendChild(bar);
 
      if(!list.length){
        const e = document.createElement("div");
        e.className = "empty";
        e.textContent = "No feedings yet. Add one below.";
        body.appendChild(e);
      }
 
      list.forEach((s, i) => {
        const row = document.createElement("div");
        row.className = "slot";
 
        const t = document.createElement("input");
        t.type = "time"; t.value = s.time;
        t.setAttribute("aria-label", "Feeding time");
        t.onchange = () => { s.time = t.value; sortDay(k); markDirty(); render(); };
 
        const r = document.createElement("select");
        r.setAttribute("aria-label", "Revolutions");
        [1,2,3].forEach(n => { const o = document.createElement("option"); o.value = n; o.textContent = n + " rev" + (n > 1 ? "s" : ""); r.appendChild(o); });
        r.value = s.revs;
        r.onchange = () => { s.revs = +r.value; markDirty(); };
 
        const cp = document.createElement("button");
        cp.className = "small"; cp.textContent = "Copy";
        cp.onclick = () => { if(!s.time) return; clip = {time: s.time, revs: s.revs}; render(); };
 
        const del = document.createElement("button");
        del.className = "small del"; del.textContent = "✕";
        del.setAttribute("aria-label", "Delete feeding");
        del.onclick = () => { list.splice(i, 1); markDirty(); render(); };
 
        row.append(t, r, cp, del);
        body.appendChild(row);
      });
 
      const add = document.createElement("button");
      add.className = "add";
      add.textContent = "+ Add feeding";
      add.onclick = () => {
        let t = "08:00";
        while(list.some(s => s.time === t)){ const [h,m] = t.split(":").map(Number); t = String((h+1)%24).padStart(2,"0") + ":" + String(m).padStart(2,"0"); }
        list.push({time: t, revs: 1});
        sortDay(k); markDirty(); render();
      };
      body.appendChild(add);
 
      card.appendChild(body);
      root.appendChild(card);
    });
  }
 
  // Load
  schedRef.once("value").then(snap => {
    const v = snap.val() || {};
    DAYS.forEach(([k]) => { sched[k] = parse(v[k]); sortDay(k); });
    loaded = true;
    setStatus("");
    render();
  }).catch(err => { setStatus("Could not load: " + err.message); render(); });
 
  // Save
  $("saveBtn").onclick = () => {
    if(!loaded){ setStatus("Still loading, try again in a moment."); return; }
    const updates = {};
    let skipped = 0;
    DAYS.forEach(([k]) => {
      skipped += sched[k].filter(s => !/^\d\d:\d\d$/.test(s.time)).length;
      updates[k] = serialize(sched[k]);
    });
    $("saveBtn").disabled = true;
    setStatus("Saving...");
    schedRef.update(updates)
      .then(() => setStatus(skipped ? "Saved. " + skipped + " feeding(s) with no time were skipped." : "Saved. The feeder will pick it up within a minute."))
      .catch(err => setStatus("Error: " + err.message))
      .finally(() => { $("saveBtn").disabled = false; });
  };
 
  render();
</script>
</body>
</html>
